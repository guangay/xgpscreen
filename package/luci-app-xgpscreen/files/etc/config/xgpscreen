config main 'main'
	option enabled '1'
	option rotate '0'
	option invert '0'
	option interval '5'
	option bg_color '#000000'
	option fg_color '#00FF88'
	option title_color '#FFAA00'
	option show_title 'XGP-V3'
	option media_dir '/mnt/mmc/screenmedia'
	option video_speed '1'
	option video_fps '20'
	option net_iface 'br-lan'

